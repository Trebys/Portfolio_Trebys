---
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import CodeIcon from "../components/icons/Code.astro";
import Projects from "../components/Projects.astro";
import UserIcon from "../components/icons/User.astro";
import MainInfo from "../components/MainInfo.astro";
import AboutMe from "../components/AboutMe.astro";
import { content, DEFAULT_LANGUAGE } from "../i18n/content";

const t = content[DEFAULT_LANGUAGE];

---

<Layout 
title={t.meta.title}
description={t.meta.description}
i18n={content}>

  <main class="px-4">
    <SectionContainer class="py-32 pb-24">
      <MainInfo>
        </slot>
      </MainInfo>
   
      
    </SectionContainer>
    <div class="space-y-24">
    <SectionContainer id="sobre-mi">
      <h2 class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white">
        <UserIcon class="size-10"/>
        <span data-i18n="about.sectionTitle">{t.about.sectionTitle}</span>
      </h2>
      <AboutMe />
      
    </SectionContainer>


    <SectionContainer id="proyectos">
      <h2 class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white ">

        <CodeIcon class="size-10"/>
        <span data-i18n="projects.sectionTitle">{t.projects.sectionTitle}</span>
      </h2>
      
      <Projects />
    </SectionContainer>

  </div>
  </main>

</Layout>
