---
import LinkedInIcon from "../components/icons/LinkedIn.astro";
import MailIcon from "../components/icons/Mail.astro";
import SocialPill from "../components/SocialPill.astro";
import GitHubIcon from "../components/icons/GitHub.astro";
import personalImage from "../images/esteban_foto.jpg";
import { DEFAULT_LANGUAGE, content } from "../i18n/content";

const t = content[DEFAULT_LANGUAGE];
---

<div class="flex flex-col-reverse items-center max-w-5xl gap-8 mx-auto md:flex-row">
  <!-- Contenido -->
  <div class="w-full min-w-0 text-center text-gray-800 md:text-left dark:text-white">
    <h1 class="text-4xl sm:text-5xl tracking-tight font-bold" data-i18n="hero.name">
      {t.hero.name}
    </h1>
    <h2
      class="text-4xl tracking-tight font-bold text-emerald-400 sm:text-5xl"
      data-i18n="hero.role"
    >
      {t.hero.role}
    </h2>
    <p
      class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-emerald-300 [&>strong]:text-emerald-400 [&>strong]:font-semibold dark:text-gray-300"
      data-i18n-html="hero.descriptionHtml"
      set:html={t.hero.descriptionHtml}
    />
    <nav class="flex flex-wrap justify-center gap-4 mt-8 md:justify-start">
      <SocialPill href="https://www.linkedin.com/in/esteban-lópez-campos">
        <LinkedInIcon class="size-4 lg:size-6" />
        LinkedIn
      </SocialPill>

      <SocialPill href="https://github.com/Trebys">
        <GitHubIcon class="size-4 lg:size-6" />
        GitHub
      </SocialPill>

      <SocialPill href="mailto:estelopez2014@gmail.com">
        <MailIcon class="size-4 lg:size-6" />
        estelopez2014@gmail.com
      </SocialPill>
    </nav>
  </div>

  <!-- Imagen -->
  <div class="flex-shrink-0">
    <img
      class="rounded-lg shadow-lg w-48 h-48 object-cover"
      src={personalImage.src}
      alt={t.hero.imageAlt}
      data-i18n-alt="hero.imageAlt"
    />
  </div>
</div>
