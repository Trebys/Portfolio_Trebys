---
const { href, class: className = "", ...props } = Astro.props;
---

<a
  href={href}
  class:list={[
    "inline-flex items-center gap-2 px-5 py-2 text-base font-semibold text-center text-white transition bg-emerald-500 rounded-lg shadow-lg hover:bg-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-300",
    className,
  ]}
  {...props}
>
  <slot />
</a>
