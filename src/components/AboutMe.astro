---
import JavaScriptIcon from "./icons/JavaScript.astro";
import SharpIcon from "./icons/CSharp.astro";
import PythonIcon from "./icons/Python.astro";
import TailWindIcon from "./icons/TailWind.astro";
import HtmlIcon from "./icons/Html.astro";
import CssIcon from "./icons/Css.astro";
import JavaIcon from "./icons/Java.astro";
import SQLIcon from "./icons/SQLServer.astro";
import PostgreSQL from "./icons/PostgreSQL.astro";
import LinkButton from "./LinkButton.astro";
import ReactIcon from "./icons/React.astro";
import DjangoIcon from "./icons/Django.astro";
import Bootstrap from "./icons/Bootstrap.astro";
import Blazor from "./icons/Blazor.astro";
import personalImage from "../images/esteban_foto.jpg";
import { DEFAULT_LANGUAGE, content } from "../i18n/content";

const t = content[DEFAULT_LANGUAGE];
---

<div class="flex flex-col items-center max-w-5xl gap-8 p-4 mx-auto mt-8 md:flex-row md:p-6">
  <!-- Imagen -->
  <div class="flex-shrink-0">
    <img
      class="rounded-lg shadow-lg w-64 h-64 object-cover"
      src={personalImage.src}
      alt={t.hero.imageAlt}
      data-i18n-alt="hero.imageAlt"
    />
  </div>

  <!-- Contenido -->
  <div class="text-gray-800 dark:text-white">
    <h1 class="text-4xl font-semibold text-emerald-400 mb-4" data-i18n="about.heading">
      {t.about.heading}
    </h1>
    <p
      class="text-xl text-gray-800 dark:[&>strong]:text-emerald-300 [&>strong]:text-emerald-400 [&>strong]:font-semibold dark:text-gray-300"
      data-i18n-html="about.bioHtml"
      set:html={t.about.bioHtml}
    />

    <!-- Icons de tecnologías -->
    <div class="flex flex-wrap gap-4 mb-6 mt-4">
      <div class="flex flex-col items-center">
        <SharpIcon class="size-6 mt-2" />
        <span class="mt-2">C#</span>
      </div>
      <div class="flex flex-col items-center">
        <Blazor class="size-6 mt-2" />
        <span class="mt-2">Blazor</span>
      </div>
      <div class="flex flex-col items-center">
        <PythonIcon class="size-6 mt-2" />
        <span class="mt-2">Python</span>
      </div>
      <div class="flex flex-col items-center">
        <DjangoIcon class="size-6 mt-2" />
        <span class="mt-2">Django</span>
      </div>
      <div class="flex flex-col items-center">
        <HtmlIcon class="size-6 mt-2" />
        <span class="mt-2">HTML</span>
      </div>
      <div class="flex flex-col items-center">
        <CssIcon class="size-6 mt-2" />
        <span class="mt-2">CSS</span>
      </div>
      <div class="flex flex-col items-center">
        <TailWindIcon class="size-6 mt-2" />
        <span class="mt-2">Tailwind</span>
      </div>
      <div class="flex flex-col items-center">
        <Bootstrap class="size-6 mt-2" />
        <span class="mt-2">Bootstrap</span>
      </div>
      <div class="flex flex-col items-center">
        <JavaScriptIcon class="size-6 mt-2" />
        <span class="mt-2">JavaScript</span>
      </div>

      <div class="flex flex-col items-center">
        <ReactIcon class="size-6 mt-2" />
        <span class="mt-2">React</span>
      </div>
      <div class="flex flex-col items-center">
        <JavaIcon class="size-6 mt-2" />
        <span class="mt-2">Java</span>
      </div>

      <div class="flex flex-col items-center">
        <SQLIcon class="size-6 mt-2" />
        <span class="mt-2">SQL Server</span>
      </div>
      <div class="flex flex-col items-center">
        <PostgreSQL class="size-6 mt-2" />
        <span class="mt-2">PostgreSQL</span>
      </div>
    </div>

    <!-- Botón de descarga de CV -->
    <LinkButton href={t.about.cvHref} download data-i18n-href="about.cvHref">
      <span data-i18n="about.cvButton">{t.about.cvButton}</span>
    </LinkButton>
  </div>
</div>
