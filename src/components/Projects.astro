---
import React from "./icons/React.astro";
import Django from "./icons/Django.astro";
import PostgreSQL from "./icons/PostgreSQL.astro";
import Tailwind from "./icons/TailWind.astro";
import LinkIcon from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";
import GitHubIcon from "./icons/GitHub.astro";
import { DEFAULT_LANGUAGE, content } from "../i18n/content";

const t = content[DEFAULT_LANGUAGE];

const PUBLISH_FANTASY_LAND_LIVE_LINK = true;
const FANTASY_LAND_LIVE_URL = "https://proyecto-brazaletes-web.vercel.app/";

const TAGS = {
  REACT: { name: "React", class: "bg-sky-600 text-white", icon: React },
  DJANGO: { name: "Django", class: "bg-emerald-800 text-white", icon: Django },
  POSTGRESQL: {
    name: "PostgreSQL",
    class: "bg-[#336791] text-white",
    icon: PostgreSQL,
  },
  TAILWIND: {
    name: "Tailwind",
    class: "bg-cyan-600 text-white",
    icon: Tailwind,
  },
};

const PROJECTS = [
  {
    title: "Fantasy Land",
    description: t.projects.description,
    github: "https://github.com/Trebys/proyecto-brazaletes-web",
    link: PUBLISH_FANTASY_LAND_LIVE_LINK ? FANTASY_LAND_LIVE_URL : null,
    image: "/projects/FantasyLand.png",
    imageAlt: t.projects.imageAlt,
    tags: [TAGS.DJANGO, TAGS.REACT, TAGS.TAILWIND, TAGS.POSTGRESQL],
    features: t.projects.features,
  },
];
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, imageAlt, title, description, tags, link, github, features }) => (
      <article class="flex flex-col items-center p-4 space-y-8 border md:p-6 group md:flex-row md:space-x-8 md:space-y-0 rounded-2xl border-emerald-400/40 bg-emerald-950/5">
        <div class="flex w-full md:w-1/2">
          <div class="relative flex items-center w-full overflow-hidden transition duration-500 ease-in-out transform shadow-xl rounded-xl bg-emerald-950/20 md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700">
            <img
              alt={imageAlt}
              data-i18n-alt="projects.imageAlt"
              class="object-contain w-full aspect-video transition duration-500 md:group-hover:scale-[1.02]"
              loading="lazy"
              src={image}
            />
          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <span
            class="inline-flex px-3 py-1 mb-3 text-xs font-semibold tracking-wide uppercase rounded-full text-emerald-950 bg-emerald-300"
            data-i18n="projects.featuredLabel"
          >
            {t.projects.featuredLabel}
          </span>
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100" data-i18n="projects.title">{title}</h3>
          <ul class="flex flex-wrap gap-2 mt-3 mb-3">
            {tags.map((tag) => (
              <li>
                <span class={`flex gap-x-2 rounded-full text-sm ${tag.class} py-1 px-2`}>
                  <tag.icon class="size-4" />
                  {tag.name}
                </span>
              </li>
            ))}
          </ul>

          <p class="text-gray-700 dark:text-gray-300" data-i18n="projects.description">{description}</p>
          <ul class="mt-3 space-y-1 text-sm text-gray-700 list-disc list-inside dark:text-gray-300">
            {features.map((feature, index) => (
              <li data-i18n={`projects.features.${index}`}>{feature}</li>
            ))}
          </ul>
          <footer class="flex flex-wrap items-end justify-start mt-4 gap-3">
            {github && (
              <LinkButton href={github} target="_blank" rel="noopener noreferrer">
                <GitHubIcon class="size-5" />
                <span data-i18n="projects.codeButton">{t.projects.codeButton}</span>
              </LinkButton>
            )}
            {link && (
              <LinkButton href={link} target="_blank" rel="noopener noreferrer">
                <LinkIcon class="size-5" />
                <span data-i18n="projects.demoButton">{t.projects.demoButton}</span>
              </LinkButton>
            )}
          </footer>
        </div>
      </article>
    ))
  }
</div>
